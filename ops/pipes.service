[Unit]
Description=pipes application deployment panel
After=network.target

[Service]
Type=simple
User=pipes
Group=deployers
WorkingDirectory=/opt/pipes
EnvironmentFile=/etc/pipes.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/pipes/dist/server/main.js
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pipes /srv/apps
ProtectHome=yes

[Install]
WantedBy=multi-user.target
