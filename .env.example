HOST=127.0.0.1
PORT=3400
DATA_DIR=.data
DEPLOY_ROOTS=/srv/apps
RETENTION_DAYS=30
NODE_ENV=development
# En producción: NODE_ENV=production y proxy HTTPS.
# CIDR o IP de proxies confiables, separados por coma; vacío = ninguno.
TRUST_PROXY=

# Webhook GitHub opcional: el nombre debe coincidir con github.secretEnv del deploy.yml.
# GITHUB_WEBHOOK_SECRET=

# Webhook GitLab opcional: debe coincidir con gitlab.secretEnv del deploy.yml.
# GITLAB_WEBHOOK_SECRET=
